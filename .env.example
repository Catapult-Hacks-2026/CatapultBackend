# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# AssemblyAI (real-time STT)
ASSEMBLYAI_API_KEY=...

# ElevenLabs (TTS)
TTS_API_KEY=...
TTS_VOICE_ID=...
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Twilio (outbound calls)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# Public URL — must be reachable by Twilio (see Testing section)
BASE_URL=https://your-ngrok-url.ngrok.io
PUBLIC_BASE_URL=https://your-public-url.ngrok.io
UPSTREAM_API_BASE_URL=https://your-upstream-api.example.com

# Email (Mailgun webhook provider)
EMAIL_PROVIDER=mailgun
EMAIL_API_KEY=key-...
EMAIL_WEBHOOK_SECRET=...
EMAIL_FROM_ADDRESS=negotiations@example.com
EMAIL_REPLY_DOMAIN=reply.example.com
